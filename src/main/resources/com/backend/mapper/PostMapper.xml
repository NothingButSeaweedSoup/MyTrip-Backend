<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.mapper.PostMapper">

    <resultMap id="BaseResultMap" type="com.backend.entity.Post">
            <id property="postId" column="post_id" />
            <result property="authorId" column="author_id" />
            <result property="hashId" column="hash_id" />
            <result property="title" column="title" />
            <result property="content" column="content" />
            <result property="views" column="views" />
            <result property="likes" column="likes" />
            <result property="commentCount" column="comment_count" />
            <result property="status" column="status" />
            <result property="hotScore" column="hot_score" />
            <result property="scoreUpdatedAt" column="score_updated_at" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        post_id,author_id,hash_id,title,content,views,
        likes,comment_count,status,hot_score,score_updated_at,
        create_time,update_time
    </sql>
</mapper>
