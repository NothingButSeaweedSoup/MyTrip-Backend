<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.mapper.ScenicSpotMapper">

    <resultMap id="BaseResultMap" type="com.backend.entity.ScenicSpot">
            <id property="spotId" column="spot_id" />
            <result property="name" column="name" />
            <result property="city" column="city" />
            <result property="address" column="address" />
            <result property="latitude" column="latitude" />
            <result property="longitude" column="longitude" />
            <result property="description" column="description" />
            <result property="tags" column="tags" />
            <result property="rating" column="rating" />
            <result property="visitDuration" column="visit_duration" />
            <result property="openTime" column="open_time" />
            <result property="phone" column="phone" />
            <result property="coverImage" column="cover_image" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        spot_id,name,city,address,latitude,longitude,
        description,tags,rating,visit_duration,open_time,
        phone,cover_image,status,create_time,update_time
    </sql>

    <select id="selectByCity" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM scenic_spot
        WHERE city = #{city} AND status = 0
    </select>
</mapper>
