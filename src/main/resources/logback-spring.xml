<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 生产：异步 Appender 降低 I/O 阻塞开销 -->
    <appender name="ASYNC-CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <neverBlock>true</neverBlock>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Redis 独立日志文件 -->
    <appender name="REDIS-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/redis.log</file>
        <createMissingDirectories>true</createMissingDirectories>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/redis.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>3</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Redis 框架日志：只写文件，控制台不显示 -->
    <logger name="io.lettuce" level="WARN" additivity="false">
        <appender-ref ref="REDIS-FILE"/>
    </logger>
    <logger name="io.lettuce.core" level="WARN" additivity="false">
        <appender-ref ref="REDIS-FILE"/>
    </logger>
    <logger name="io.netty" level="WARN" additivity="false">
        <appender-ref ref="REDIS-FILE"/>
    </logger>
    <logger name="org.springframework.data.redis" level="WARN" additivity="false">
        <appender-ref ref="REDIS-FILE"/>
    </logger>

    <!-- 应用层 Redis 日志：只写文件，控制台不显示 -->
    <logger name="redis.app" level="WARN" additivity="false">
        <appender-ref ref="REDIS-FILE"/>
    </logger>

    <!-- 第三方库降级 WARN 减少日志量 -->
    <logger name="com.baomidou" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure.data.redis" level="WARN" additivity="false">
        <appender-ref ref="REDIS-FILE"/>
    </logger>
    <logger name="dev.langchain4j" level="WARN"/>
    <logger name="okhttp3" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="ASYNC-CONSOLE"/>
    </root>
</configuration>
